    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "setup": "bash scripts/dev-setup.sh",
    "apps:pull": "node scripts/apps-sync.mjs pull",
    "apps:push": "node scripts/apps-sync.mjs push"
  },
