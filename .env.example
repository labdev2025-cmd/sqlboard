# Copie para .env (ou .env.local) e ajuste. Nunca commite o arquivo real.

# Banco de metadados do sqlboard (PostgreSQL 16+).
DATABASE_URL=postgres://sqlboard:sqlboard@localhost:5432/sqlboard

# Segredo das sessões do Better Auth. Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-valor-aleatorio-de-32-bytes
# URL pública da aplicação.
BETTER_AUTH_URL=http://localhost:3000

# Chave AES-256-GCM das senhas de conexão (32 bytes em base64).
# Gere com: openssl rand -base64 32
SQLBOARD_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Versão da chave atual (incremente ao rotacionar).
SQLBOARD_ENCRYPTION_KEY_VERSION=1
# Chaves antigas para leitura durante a rotação: "versão:base64,versão:base64".
# SQLBOARD_ENCRYPTION_OLD_KEYS=

# Banco de demonstração (dados fictícios), criado por scripts/dev-setup.sh.
# Usuário somente leitura usado pela conexão "Demo" criada no seed.
DEMO_DB_HOST=localhost
DEMO_DB_PORT=5432
DEMO_DB_NAME=sqlboard_demo
DEMO_DB_USER=sqlboard_demo_ro
DEMO_DB_PASSWORD=demo_ro_local

# Envio de e-mail dos agendamentos (F6). Sem SMTP_URL, os e-mails são
# gravados em .data/outbox (útil em desenvolvimento).
# SMTP_URL=smtp://usuario:senha@smtp.exemplo.com:587
# SMTP_FROM="sqlboard <sqlboard@exemplo.com>"

# Liga o agendador interno (padrão: ligado em produção).
# SQLBOARD_SCHEDULER=on
